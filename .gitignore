node_modules/
dist/

# Build-verification output
verify-artifacts/
verify-report.json

# Raw Basketball Reference season exports - the INPUT to
# tools/build-data-from-csv.mjs, never read at runtime. 3.4 MB of CSV that
# every repo-wide search had to wade through; re-download only when the
# dataset actually needs regenerating (see tools/README.md).
tools/seasons/

# Generated from js/data.js by tools/export-players-json.mjs, and only needed
# transiently while seeding the server's players table. Committing it meant
# carrying a second 500 KB copy of a dataset already in the repo - and two
# copies of the same data are two things that can disagree.
db/seed/players.json

tools/seasons-nfl/

# The per-season players seed: 1.1MB of generated INSERTs, regenerable from
# data/nba-players.js in one command. Committing it would put a megabyte of
# machine-written SQL in every clone and every diff to say what the dataset
# already says.
db/seed/players-seed.sql

# Full-resolution banner originals. Not committed - 48 MB of source for 8 MB of
# shipped output. See the header of tools/build-banner-art.mjs.
tools/banner-source/
